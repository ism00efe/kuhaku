{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewerOutput",
  "type": "object",
  "required": ["axis", "findings"],
  "properties": {
    "axis": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "issue"],
        "properties": {
          "severity": { "enum": ["blocker", "warning", "info"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "issue": { "type": "string", "description": "one sentence, the problem" },
          "evidence": { "type": "string", "description": "quoted code or fact from the input" },
          "reasoning": { "type": "string", "description": "why it is a problem, <= 2 sentences" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
